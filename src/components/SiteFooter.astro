---
import { GithubIcon } from "@sanity/icons"

const { pageIcon = null } = Astro.props
---

<footer class="site-footer">
  <p>
    © {new Date().getFullYear()} Konrad Dierks · Hosted on GitHub Pages · Built
    with{" "}
    <a href="https://astro.build" target="_blank" rel="noopener noreferrer">
      Astro
    </a>
  </p>
  <p>
    Source code:{" "}
    <span class="inline-link-with-icon">
      <GithubIcon className="link-icon" aria-hidden="true" />
      <a
        href="https://github.com/konrad-dierks/personal-page"
        target="_blank"
        rel="noopener noreferrer"
      >
        https://github.com/konrad-dierks/personal-page
      </a>
    </span>
    <br />
    {pageIcon === "turnout" && (
      <>
        The webpage icon "
        <a
          href="https://commons.wikimedia.org/w/index.php?curid=157180000"
          target="_blank"
          rel="noopener noreferrer"
        >
          Arcticons-black emoji ballot box with ballot
        </a>
        " by Arcticons Team is licensed under{" "}
        <a
          target="_blank"
          rel="noopener noreferrer"
          href="https://creativecommons.org/licenses/by-sa/4.0/?ref=openverse"
        >
          CC BY-SA 4.0{" "}
        </a>
        . Modified for greater line width. On dark browser theme: further
        modified for color inversion.
        <br />
      </>
    )}
    {pageIcon === "jmp" && (
      <>
        The webpage icon "
        <a
          href="https://tabler.io/icons?icon=building-wind-turbine"
          target="_blank"
          rel="noopener noreferrer"
        >
          building-wind-turbine
        </a>
        " from Tabler Icons by Paweł Kuna is licensed under the{" "}
        <a
          target="_blank"
          rel="noopener noreferrer"
          href="https://github.com/tabler/tabler-icons/blob/main/LICENSE"
        >
          MIT License
        </a>
        . Modified for reduced line width. On dark browser theme: further
        modified for color inversion.
        <br />
      </>
    )}
    Third party packages: <a href="/notice/">Notice</a>
  </p>
  <p>
    Contact:{" "}
    <a href="mailto:konrad.dierks@ecomail.fr">konrad.dierks@ecomail.fr</a>,{" "}
    <a href="mailto:konrad.dierks@tse-fr.eu">konrad.dierks@tse-fr.eu</a>
    <br />I acknowledge funding from the French National Research Agency under
    the EUR grant ANR-18-EURE-0021, the grant ANR-21-ESRE-0051 (computing
    resources from the MesoNET resources center, allocation m26158), and the
    project AVINEQ.
  </p>
</footer>
